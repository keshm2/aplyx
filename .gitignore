# Live config — contains secrets/PII. Copy the *.example.json files to start.
/src/config/targets.json
/src/config/discord_config.json

# Phase 3: Google Sheets sync — live config + service-account key (secrets).
/src/config/google_sheets_config.json
/src/config/service-account-key.json

# Phase 11: hosted Supabase backend — live project URL + anon key.
/src/config/supabase.json

# job_cache's own project — deliberately separate from the one above
# (src/config/supabase.json is hosted auth/profile sync) so the two
# workloads don't share one project's disk I/O budget. See
# src/core/src/supabaseConfig.ts's readJobCacheSupabaseConfig.
/src/config/job_cache_supabase.json

# job_cache's Redis warm layer (read-only token) — see
# src/core/src/redisConfig.ts's readJobCacheRedisConfig.
/src/config/job_cache_redis.json

# Anthropic API key for the direct-API judgment calls (interest-letter,
# resume-tailor) — see src/scripts/runtime/generate_interest_letter.py's
# read_anthropic_key. ANTHROPIC_API_KEY env var is checked first; this
# file is the local-file fallback, same pattern as job_cache_redis.json.
/src/config/anthropic_key.json

# Runtime state
/data/applied_jobs.json
/data/review_queue.json
/data/job_registry.json
/data/job_events.jsonl
# Interest letters are the user's own words about themselves — PII, same as
# every other data/ file. NOTE: this list enumerates files individually
# rather than ignoring /data/, so ANY new state file must be added here
# explicitly or it gets committed. Adding a data file? Add it here first.
/data/interest_letters.json

# Personal PII — base resumes + cover letter
/data/resumes/
# Resumes are PII and belong ONLY in data/resumes/. A stray copy elsewhere
# (app/base_resume_swe.pdf was staged once) is still a resume, so ignore the
# pattern repo-wide rather than trusting the one directory rule.
base_resume_*.pdf
base_resume_*.md
*_resume.pdf
cover_letter*.pdf

# Playwright MCP browser session artifacts (logs, page snapshots) — can
# land in any subdirectory depending on the MCP server's cwd at the time
.playwright-mcp/

# Logs
*.log
/logs/

# Dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# Editor swap/backup files
*.swp
*.swo
*~

# Python bytecode
__pycache__/
*.pyc

# Plan / handoff documents (lives in docs/ but is not committed)
docs/PLAN.md
system_architecture.md
# Phase 13: TUI package build artifacts
/src/tui/node_modules/
/src/tui/dist/

# Shared TS core package build artifacts (src/core)
/src/core/node_modules/
/src/core/dist/

# Phase 14: Tauri desktop app build artifacts
/src/tauri/node_modules/
/src/tauri/dist/
/src/tauri/src-tauri/target/

# Phase 15: per-machine harness selection
/src/config/harness.json
/src/config/env.json
/.claude/settings.json

# Phase 10: browser extension — build artifacts + per-install bridge token
/src/extension/dist/
/src/config/extension_bridge.json

# Token-optimizer files (a Claude Code skill's local session-tracking
# state, unrelated to aplyx — can land in any subdirectory depending
# on which directory a session's CWD was in)
token-optimizer/
