{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "job-scraper",
  "instructions": [
    "AGENTS.md",
    "src/config/targets.json",
    "data/applied_jobs.json"
  ],
  "permission": {
    "edit": "allow",
    "bash": { "*": "allow" },
    // "ask" auto-rejects with no chance to recover in headless/scheduled
    // runs (no TTY to prompt) — repeatedly killed real runs mid-phase
    // whenever the agent reached for a path outside the project (e.g. a
    // /tmp/ scratch file while checking a fetched page), losing whatever
    // job was in progress. bash is already "*": "allow" above, i.e.
    // already unrestricted read/write to anything this OS user can touch
    // via `cat`/`cp`/`mv`/etc. — "ask" here only ever gated the native
    // file-read/write tools taking the same path politely, not a real
    // security boundary bash didn't already remove. "allow" makes this
    // consistent with that instead of leaving a friction point that
    // silently kills unattended runs.
    "external_directory": { "*": "allow" }
  },
  "model": "opencode-go/minimax-m3",
  "agent": {
    "job-scraper": {  
      "model": "opencode-go/minimax-m3"
    }
  }, 
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}